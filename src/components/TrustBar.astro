---
// NOTE: Figures are placeholders — confirm actual numbers before launch.
const stats = [
  { value: "20+", label: "Countries served" },
  { value: "6", label: "Core product lines" },
  { value: "100%", label: "Batch QC & COA" },
  { value: "24/7", label: "Technical support" },
];
---

<section class="border-b border-slate-100 bg-white">
  <div class="container grid grid-cols-2 gap-y-8 py-12 md:grid-cols-4">
    {stats.map((s) => (
      <div class="text-center">
        <p class="font-display text-4xl font-extrabold tracking-tight text-navy-900">{s.value}</p>
        <p class="mt-1 text-sm font-medium text-slate-500">{s.label}</p>
      </div>
    ))}
  </div>
</section>
