---
import Icon from "./Icon.astro";
import { productLines } from "../data/industries";
---

<section class="relative overflow-hidden bg-navy-950 text-white">
  <!-- decorative background -->
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <div class="absolute -top-24 -right-24 h-96 w-96 rounded-full bg-teal-500/20 blur-3xl"></div>
    <div class="absolute -bottom-32 -left-16 h-96 w-96 rounded-full bg-navy-600/30 blur-3xl"></div>
    <svg class="absolute inset-0 h-full w-full opacity-[0.06]" viewBox="0 0 1200 800" fill="none">
      <defs>
        <pattern id="grid" width="48" height="48" patternUnits="userSpaceOnUse">
          <path d="M48 0H0v48" stroke="white" stroke-width="1" />
        </pattern>
      </defs>
      <rect width="1200" height="800" fill="url(#grid)" />
    </svg>
  </div>

  <div class="container relative grid items-center gap-14 py-20 lg:grid-cols-[1.15fr_0.85fr] lg:py-28">
    <div>
      <span class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/5 px-4 py-1.5 text-xs font-semibold uppercase tracking-[0.14em] text-teal-300">
        <Icon name="globe" class="h-4 w-4" />
        Export-focused supplier
      </span>
      <h1 class="mt-6 max-w-2xl font-display text-[2.1rem] font-extrabold leading-[1.1] tracking-tight sm:text-5xl lg:text-[3.4rem]">
        Water-treatment chemicals that cut cost per m³ and keep results stable.
      </h1>
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-slate-300">
        EfanChem supplies PAM, PAC, PFS and activated carbon — with water-sample
        testing, product selection and continuous technical support for distributors,
        EPC contractors and industrial plants.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/contact/" class="btn btn-primary">
          Request a Sample
          <Icon name="arrow-right" class="h-4 w-4" />
        </a>
        <a href="/products/" class="btn btn-ghost-dark">
          Explore Products
        </a>
      </div>
      <ul class="mt-8 flex flex-wrap gap-x-6 gap-y-2 text-sm text-slate-300">
        <li class="flex items-center gap-2">
          <Icon name="check" class="h-4 w-4 text-teal-400" /> COA & third-party testing
        </li>
        <li class="flex items-center gap-2">
          <Icon name="check" class="h-4 w-4 text-teal-400" /> OEM & private-label packaging
        </li>
        <li class="flex items-center gap-2">
          <Icon name="check" class="h-4 w-4 text-teal-400" /> On-site technical support
        </li>
      </ul>
    </div>

    <div class="relative">
      <div class="rounded-3xl border border-white/10 bg-white/5 p-6 shadow-2xl backdrop-blur-sm sm:p-8">
        <div class="flex items-center justify-between">
          <p class="text-sm font-semibold uppercase tracking-[0.14em] text-slate-400">Supply Programme</p>
          <span class="inline-flex items-center gap-1.5 rounded-full bg-teal-500/15 px-3 py-1 text-xs font-semibold text-teal-300">
            <Icon name="shield-check" class="h-3.5 w-3.5" /> Batch QC
          </span>
        </div>
        <ul class="mt-6 space-y-4">
          {productLines.map((line) => (
            <li class="flex items-start gap-4 rounded-2xl bg-white/5 p-4">
              <span class="grid h-11 w-11 shrink-0 place-items-center rounded-xl bg-teal-500/20 text-teal-300">
                <Icon name={line.icon} class="h-5 w-5" />
              </span>
              <div>
                <p class="font-display font-bold text-white">{line.name}</p>
                <p class="mt-1 text-sm text-slate-300">{line.focus}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>
