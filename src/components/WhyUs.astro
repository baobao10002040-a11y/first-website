---
import Icon from "./Icon.astro";

const points = [
  {
    icon: "target",
    title: "Application-effect oriented",
    text: "We optimise for cost per treated m³, clearer effluent, lower sludge moisture and higher throughput — not just a low per-tonne price.",
  },
  {
    icon: "layers",
    title: "Full product portfolio",
    text: "PAM, PAC, PFS, ferrous sulfate, activated carbon and auxiliaries from one supplier — fewer vendors to manage.",
  },
  {
    icon: "flask",
    title: "Water-sample testing & selection",
    text: "A standard service from water analysis and candidate recommendation to batch supply and on-site guidance.",
  },
  {
    icon: "shield-check",
    title: "Stable quality control",
    text: "Raw-material, molecular-weight, charge, solid-content and batch-lot control, with COA and third-party testing.",
  },
  {
    icon: "globe",
    title: "Flexible export & customisation",
    text: "Neutral or OEM packaging, custom COA, SDS/TDS and origin documents, plus trial orders to framework contracts.",
  },
];
---

<div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
  {points.map((p) => (
    <article class="rounded-2xl border border-slate-200 bg-white p-7">
      <span class="grid h-12 w-12 place-items-center rounded-xl bg-teal-50 text-teal-600">
        <Icon name={p.icon} class="h-6 w-6" />
      </span>
      <h3 class="mt-5 font-display text-lg font-bold text-navy-900">{p.title}</h3>
      <p class="mt-2 text-sm leading-relaxed text-slate-600">{p.text}</p>
    </article>
  ))}

  <a
    href="/contact/"
    class="group flex flex-col justify-between rounded-2xl bg-navy-900 p-7 text-white transition-colors hover:bg-navy-800"
  >
    <div>
      <span class="grid h-12 w-12 place-items-center rounded-xl bg-white/10 text-teal-300">
        <Icon name="arrow-up-right" class="h-6 w-6" />
      </span>
      <h3 class="mt-5 font-display text-lg font-bold">Ready to optimise your water treatment?</h3>
      <p class="mt-2 text-sm leading-relaxed text-slate-300">
        Send us a water sample or process description and we will recommend the right
        grade and dosage.
      </p>
    </div>
    <span class="mt-6 inline-flex items-center gap-1.5 text-sm font-semibold text-teal-300">
      Request a sample
      <Icon name="arrow-right" class="h-4 w-4 transition-transform group-hover:translate-x-0.5" />
    </span>
  </a>
</div>
