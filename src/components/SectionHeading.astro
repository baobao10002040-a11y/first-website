---
interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  align?: "left" | "center";
  dark?: boolean;
}

const { eyebrow, title, subtitle, align = "center", dark = false } = Astro.props;
---

<div class:list={["max-w-2xl", align === "center" ? "mx-auto text-center" : "text-left"]}>
  {eyebrow && <span class="eyebrow">{eyebrow}</span>}
  <h2
    class:list={[
      "mt-3 font-display text-3xl font-extrabold tracking-tight sm:text-4xl",
      dark ? "text-white" : "text-navy-900",
    ]}
  >
    {title}
  </h2>
  {subtitle && (
    <p class:list={["mt-4 text-lg leading-relaxed", dark ? "text-slate-300" : "text-slate-600"]}>
      {subtitle}
    </p>
  )}
</div>
