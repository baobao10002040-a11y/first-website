---
import Icon from "./Icon.astro";

interface Props {
  title?: string;
  subtitle?: string;
}

const {
  title = "Ready to lower your cost per cubic metre?",
  subtitle = "Send us a water sample or process description and we will recommend the right grade, dosage and supply plan.",
} = Astro.props;
---

<section class="bg-navy-900">
  <div class="container py-16 text-center sm:py-20">
    <h2 class="mx-auto max-w-2xl font-display text-3xl font-extrabold tracking-tight text-white sm:text-4xl">
      {title}
    </h2>
    <p class="mx-auto mt-4 max-w-xl text-lg text-slate-300">{subtitle}</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/contact/" class="btn btn-primary">
        Request a Sample
        <Icon name="arrow-right" class="h-4 w-4" />
      </a>
      <a href="/products/" class="btn btn-ghost-dark">View Products</a>
    </div>
  </div>
</section>
