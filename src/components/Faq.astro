---
const faqs = [
  {
    q: "Why do results vary between chemical batches?",
    a: "Common causes are fluctuating raw water, an unsuitable product grade, wrong molecular weight or charge, incorrect dissolution concentration, a poor dosing point, or the wrong mixing time. We collect your water and sludge data, recommend the right grade, guide jar testing and keep a backup grade for seasonal changes.",
  },
  {
    q: "Your product looks more expensive per tonne. Why should we switch?",
    a: "Comparing only per-tonne price is misleading. A product with a higher unit price can use far less chemical, so the true cost per treated cubic metre is lower. We help you evaluate cost per m³, optimise the grade and design combined purchasing to cut total spend.",
  },
  {
    q: "Our sludge dewatering is poor — high cake moisture and clogged filter cloths.",
    a: "We adjust the cationic PAM charge density, select the right molecular weight, optimise the solution concentration and dosing point, and re-test with your equipment. We provide side-by-side comparisons of different grades for your press or centrifuge.",
  },
  {
    q: "Can you guarantee stable, on-time delivery?",
    a: "Yes. We build safety stock, offer quarterly or annual purchase agreements, run multi-plant production, share a production plan before delivery, confirm vessel and port in advance, and provide a stocking mechanism for key customers.",
  },
  {
    q: "We have no technical staff to run tests. Can you help?",
    a: "We provide English technical documents, remote video guidance, a standard jar-test method and a product-selection table. Support is available by WhatsApp, email and video call, and we can arrange on-site technical service for key customers.",
  },
  {
    q: "What are your minimum order quantities and packaging options?",
    a: "We support small trial orders up to long-term framework contracts. Packaging includes bags, jumbo bags and liquid options, with neutral, OEM or private-label branding and custom labels.",
  },
  {
    q: "What documents do you provide with each shipment?",
    a: "COA, TDS, SDS and certificate of origin, plus sea or land shipping documents as required. Custom COA and labelling are available.",
  },
];
---

<div class="mx-auto max-w-3xl divide-y divide-slate-200 rounded-2xl border border-slate-200 bg-white px-6 sm:px-8">
  {faqs.map((f, i) => (
    <details class="group py-5" open={i === 0}>
      <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-left">
        <span class="font-display font-bold text-navy-900">{f.q}</span>
        <span class="grid h-7 w-7 shrink-0 place-items-center rounded-full bg-slate-100 text-slate-500 transition-transform group-open:rotate-45">
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <path d="M12 5v14M5 12h14" />
          </svg>
        </span>
      </summary>
      <p class="mt-3 text-sm leading-relaxed text-slate-600">{f.a}</p>
    </details>
  ))}
</div>
