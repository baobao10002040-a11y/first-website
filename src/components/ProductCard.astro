---
import Icon from "./Icon.astro";
import type { Product } from "../data/products";

interface Props {
  product: Product;
}

const { product } = Astro.props;
---

<article class="group flex flex-col rounded-2xl border border-slate-200 bg-white p-6 transition-shadow hover:shadow-lg hover:shadow-slate-200/60">
  <span class="grid h-12 w-12 place-items-center rounded-xl bg-navy-50 text-navy-700">
    <Icon name={product.icon} class="h-6 w-6" />
  </span>
  <h3 class="mt-5 font-display text-lg font-bold text-navy-900">{product.name}</h3>
  <p class="mt-1 text-sm font-medium text-teal-600">{product.tagline}</p>
  <p class="mt-3 flex-1 text-sm leading-relaxed text-slate-600">{product.description}</p>
  <a
    href={`/products/#${product.slug}`}
    class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-navy-900 transition-colors hover:text-teal-600"
  >
    View details
    <Icon name="arrow-right" class="h-4 w-4 transition-transform group-hover:translate-x-0.5" />
  </a>
</article>
