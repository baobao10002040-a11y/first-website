---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import Icon from "../components/Icon.astro";
import CtaBand from "../components/CtaBand.astro";
import SectionHeading from "../components/SectionHeading.astro";
import { industries, productLines } from "../data/industries";
---

<Layout
  title="Industries & Applications"
  description="Water-treatment chemicals for distributors, engineering and EPC contractors, municipal plants, mining, paper, textile, food and stone processing."
  canonicalPath="/industries/"
>
  <PageHeader
    eyebrow="Industries"
    title="Who we serve"
    subtitle="Each industry has a tailored programme — matched grades, dosing guidance and supply support for your specific water and sludge conditions."
  />

  <section class="bg-slate-50 py-16 sm:py-20">
    <div class="container space-y-10">
      {industries.map((ind) => (
        <article id={ind.slug} class="scroll-mt-24 rounded-3xl border border-slate-200 bg-white p-7 sm:p-10">
          <div class="flex items-center gap-4">
            <span class="grid h-13 w-13 shrink-0 place-items-center rounded-2xl bg-teal-50 text-teal-600">
              <Icon name={ind.icon} class="h-7 w-7" />
            </span>
            <div>
              <h2 class="font-display text-2xl font-extrabold text-navy-900">{ind.name}</h2>
            </div>
          </div>
          <p class="mt-5 max-w-3xl leading-relaxed text-slate-600">{ind.overview}</p>

          <div class="mt-8 grid gap-8 lg:grid-cols-2">
            <div>
              <p class="text-xs font-bold uppercase tracking-[0.14em] text-slate-400">Common pain points</p>
              <ul class="mt-3 space-y-2.5">
                {ind.painPoints.map((p) => (
                  <li class="flex items-start gap-2.5 text-sm text-slate-600">
                    <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-slate-300"></span>
                    {p}
                  </li>
                ))}
              </ul>
            </div>
            <div>
              <p class="text-xs font-bold uppercase tracking-[0.14em] text-slate-400">Our solution</p>
              <ul class="mt-3 space-y-2.5">
                {ind.solution.map((s) => (
                  <li class="flex items-start gap-2.5 text-sm text-slate-600">
                    <Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-teal-500" />
                    {s}
                  </li>
                ))}
              </ul>
            </div>
          </div>

          <div class="mt-7 border-t border-slate-100 pt-5">
            <p class="text-xs font-bold uppercase tracking-[0.14em] text-slate-400">Expected results</p>
            <div class="mt-3 flex flex-wrap gap-2">
              {ind.outcomes.map((o) => (
                <span class="rounded-full bg-teal-50 px-3 py-1 text-sm font-medium text-teal-700">{o}</span>
              ))}
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="bg-white py-16 sm:py-20">
    <div class="container">
      <SectionHeading
        eyebrow="Three supply lines"
        title="A programme built around how you buy"
        subtitle="We organise supply around your role — distributor, contractor or end-user — so you get the right focus."
      />
      <div class="mt-12 grid gap-6 md:grid-cols-3">
        {productLines.map((line) => (
          <article class="rounded-2xl border border-slate-200 bg-white p-7">
            <span class="grid h-12 w-12 place-items-center rounded-xl bg-navy-50 text-navy-700">
              <Icon name={line.icon} class="h-6 w-6" />
            </span>
            <h3 class="mt-5 font-display text-lg font-bold text-navy-900">{line.name}</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-600">{line.description}</p>
            <p class="mt-4 border-t border-slate-100 pt-4 text-sm font-semibold text-teal-600">{line.focus}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <CtaBand />
</Layout>
